#USUARIOS QLIK
QLIK_USUARIO=dominio\\usuario
QLIK_EMAIL=bi@sspj.go.gov.br
QLIK_SENHA=suasenha123

#LINK QAP
QLIK_QMC_QAP=https://URLQLIK/qmc
QLIK_TASK_QAP=https://URLQLIK/qmc/tasks

#LINK HUB
QLIK_QMC_HUB=https://URLQLIK/qmc
QLIK_TASK_HUB=https://URLQLIK/qmc/tasks

#LINK NPRINT
QLIK_NPRINT=https://NPRINT
QLIK_NPRINT_TASK=https://NPRINT/#/tasks/executions

#CAMINHO CHROMEDRIVER
CHROMEDRIVER=C:\Users\wagner.filho\Documents\GitHub\WebScrepStatusQlik\chromedriver\chromedriver.exe

# Evolution API (scripts Python e envio de mensagens)
# Se esta URL falhar, o script tenta na ordem: localhost:8080 → ssp-02824037:8080 → 10.242.31.154:8080
EVOLUTION_BASE_URL=http://localhost:8080
# Apikey da Evolution API (header "apikey") - mesmo valor de AUTHENTICATION_API_KEY no .env da evolution_api
EVOLUTION_API_TOKEN=sua_apikey_aqui
# Nome da instância conectada (ex.: bisspgo, odisseu)
EVOLUTION_INSTANCE_ID=bisspgo
EVOLUTION_INSTANCE_NAME=teste
# Números ou JIDs para envio (vírgula separada)
EVO_DESTINO=556290000000,556290000001
# JIDs de grupos para envio (ex.: 120363086277869845@g.us)
EVO_DESTINO_GRUPO=NUMERO_DO_GRUPO@g.us,NUMERO_DO_GRUPO2@g.us
# Grupo administrativo: recebe notificação em caso de falha no envio (ex.: BI SSP)
EVO_GRUPO_ADMIN=JID_GRUPO_ADMIN@g.us
# Fallbacks opcionais para Evolution API (vírgula separada)
# EVOLUTION_FALLBACK_URLS=http://host:8080,http://ip:8080

# Conexão Banco Oracle Replica
ORACLE_HOST=IP_DO_HOST
ORACLE_PORT=1521
ORACLE_TNS=NOME_DO_TNS
ORACLE_USER=USUARIO
ORACLE_PASSWORD=SENHA

#CREDENCIAIS DE REDE
NETWORK_USERNAME=dominio\\usuario
NETWORK_PASSWORD=suasenha123
NETWORK_DOMAIN=dominio

#CAMINHOS DE REDE
NETWORK_PATH_1=\\caminho\pasta1
NETWORK_PATH_2=\\caminho\pasta2
NETWORK_PATH_3=\\caminho\pasta3

# GitLab (SQL remota para pysql homicidios/feminicidio - repositório odisseu-reports)
# Copie este arquivo para .env na raiz do projeto: copy .env_exemple .env (Windows) ou cp .env_exemple .env (Linux)
GITLAB_BASE_URL=https://gitlab.ssp.go.gov.br
# Projeto onde estão os SQLs de feminicídios e homicídios (odisseu-reports)
GITLAB_PROJECT=ssp/bi/odisseu-reports
GITLAB_TOKEN=seu_token_aqui
GITLAB_BRANCH=main
GITLAB_SQL_PATH_HOMICIDIOS=extract_odisseu_oracle/relatorio_homicidios
GITLAB_SQL_PATH_FEMINICIDIOS=extract_odisseu_oracle/relatorio_feminicidios

# Scheduler PySQL + Evolution (scheduler_pysql_evolution.py) - opcional
PYSQL_SCHEDULER_HORA=8
PYSQL_SCHEDULER_MINUTO=0
PYSQL_SCHEDULER_INTERVALO_SEG=60

# Webhook: comando por WhatsApp (@número do robô) para disparar relatório sob demanda
# Número do WhatsApp conectado à instância Evolution (só dígitos, ex.: 5562981613538)
EVOLUTION_BOT_NUMBER=5562981613538
# Porta do servidor webhook (Evolution chama esta URL ao receber mensagens)
WEBHOOK_PYSQL_PORT=5050
# Ativar webhook no scheduler (true/false)
WEBHOOK_PYSQL_ENABLED=true
# Registrar webhook na Evolution ao iniciar (iniciar_pysql_evolution.ps1). true = verifica/registra; false = não altera
EVOLUTION_WEBHOOK_AUTO_REGISTER=true
# URL que a Evolution API deve chamar (acessível pelo servidor Evolution). Ex.: http://IP_DA_MAQUINA:5050/webhook
EVOLUTION_WEBHOOK_PUBLIC_URL=http://SEU_IP:5050/webhook
# Timeout para aguardar resposta 1/2 em segundos (padrão 300 = 5 min)
# WEBHOOK_PYSQL_TIMEOUT_CONFIRMACAO=300